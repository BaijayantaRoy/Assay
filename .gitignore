# ============================================================
#  Assay — .gitignore
#  A trailing "#" is NOT a comment in this format: it becomes
#  part of the pattern. Every note here is on its own line.
# ============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
venv/
.venv/
*.egg-info/
dist/
build/

# ---------- Node / Next.js ----------
node_modules/
frontend/.next/
frontend/out/
frontend/build/
.pnp.*
.yarn/*

# ---------- Database ----------
database.db
*.db-journal

# ---------- Vector DB ----------
chroma_data/

# ---------- Environment ----------
.env
.env.local
.env.*.local

# ---------- IDE ----------
.vscode/
.idea/
*.swp
*.swo
*~

# ---------- OS ----------
.DS_Store
Thumbs.db
Desktop.ini

# ---------- Logs ----------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------- Build artifacts ----------
*.tsbuildinfo
next-env.d.ts
*.spec
/site/
/.tmp/
.docker-frontend-build.*

# ---------- Test and lint caches ----------
# ADDED: present on disk, never ignored
/.pytest_cache/
.ruff_cache/
# ADDED: was in .dockerignore but not here - the two files had drifted
.hypothesis/
# ADDED: coverage output
.coverage
coverage.xml
htmlcov/

# ---------- Key material (NEVER commit) ----------
# The licensing layer is gone (docs/architecture/adr/0007-fully-open-source.md);
# this rule stays as a blanket guard against key material re-entering the repo.
*.pem
*.key
*.p12
*.pfx

# ---------- Written by the example loop when it runs ----------
# prompts/loops/verified-pipeline writes these into the workspace root.
stage1.txt
stage2.txt
artifact.txt
marker.txt

# ---------- Machine-local state and metadata ----------
# Workspace state, logs and status snapshots. None of it is source.
.assay/
.mpl/
models.json.bak

# ---------- Generated by the Next.js dev server ----------
# `next dev` writes these when it detects a coding agent. They describe Next.js, not
# this project, and are regenerated on demand.
frontend/AGENTS.md
frontend/CLAUDE.md
