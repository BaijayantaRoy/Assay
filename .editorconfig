# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,jsx,ts,tsx,json,jsonc,css,scss,yml,yaml}]
indent_size = 2

[*.md]
indent_size = 2
# Markdown uses two trailing spaces as a hard line break
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf

[Makefile]
indent_style = tab

# PromptFiles are the published artifact format. Keep them byte-stable:
# a conforming writer must preserve unknown fields and must not reformat the body.
[*.prompt.md]
trim_trailing_whitespace = false
