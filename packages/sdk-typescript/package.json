{
  "name": "@assay/sdk",
  "version": "1.0.0",
  "description": "TypeScript SDK for Assay — versioned, evaluated prompts for any LLM.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node tests/stream.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["prompt", "llm", "prompt-engineering", "promptfile", "mcp", "evals", "ai"],
  "license": "MIT",
  "engines": { "node": ">=18" },
  "devDependencies": { "typescript": "^5.6.0" },
  "dependencies": {}
}
