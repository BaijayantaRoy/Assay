{
  "name": "@assay/promptfile",
  "version": "1.0.0",
  "description": "Independent TypeScript reader/writer for the PromptFile v1 specification.",
  "author": "Baijayanta Roy",
  "homepage": "https://github.com/BaijayantaRoy/Assay#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BaijayantaRoy/Assay.git",
    "directory": "packages/promptfile-typescript"
  },
  "bugs": {
    "url": "https://github.com/BaijayantaRoy/Assay/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "sync-schema": "node scripts/sync-schema.mjs",
    "check-schema": "node scripts/sync-schema.mjs --check",
    "build": "npm run sync-schema && tsc -p tsconfig.json",
    "test": "npm run build && node tests/conformance.mjs",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "ajv": "^8.20.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.9.2"
  }
}
