# ============================================================
#  Assay — .dockerignore
# ============================================================

# Python
__pycache__/
*.pyc
venv/
.venv/

# Node
node_modules/
**/node_modules/
frontend/.next/
**/.next/
frontend/out/
frontend/tests/
frontend/test-results/
frontend/playwright-report/

# Local build and verification evidence
.tmp/
site/
dist/
**/dist/
.pytest_cache/
.hypothesis/
.assay/

# Database (will be created at runtime)
database.db
chroma_data/

# Git
.git/
.gitignore

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Docs
*.md
!README.md
!packages/assay-core/README.md
!spec/promptfile-v1.md
!LICENSE

# Dev scripts
*.ps1
start.bat
start-assay.sh
