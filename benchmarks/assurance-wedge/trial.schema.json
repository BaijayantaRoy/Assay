{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assay.dev/schemas/assurance-wedge-trials-v1.json",
  "title": "Assay assurance-wedge benchmark trials",
  "type": "object",
  "required": ["protocol", "trials"],
  "properties": {
    "protocol": { "const": "assay-assurance-wedge-v1" },
    "trials": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id", "product_id", "product_version", "metric_id", "task_id",
          "operator_id", "task_author_id", "environment", "usable", "completed",
          "measurement", "raw_artifacts"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "product_id": { "type": "string", "minLength": 1 },
          "product_version": { "type": "string", "minLength": 1 },
          "metric_id": { "type": "string", "minLength": 1 },
          "task_id": { "type": "string", "minLength": 1 },
          "operator_id": { "type": "string", "minLength": 1 },
          "task_author_id": { "type": "string", "minLength": 1 },
          "environment": {
            "type": "object",
            "required": ["os", "runtime", "clean_setup"],
            "properties": {
              "os": { "type": "string", "minLength": 1 },
              "runtime": { "type": "string", "minLength": 1 },
              "clean_setup": { "type": "boolean", "const": true }
            },
            "additionalProperties": true
          },
          "usable": { "type": "boolean" },
          "completed": { "type": "boolean" },
          "measurement": { "type": "object" },
          "raw_artifacts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["uri", "sha256"],
              "properties": {
                "uri": { "type": "string", "minLength": 1 },
                "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
