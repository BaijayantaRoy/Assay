# ============================================================
#  Assay — Environment Configuration
#  Copy this to .env and fill in your values
# ============================================================

# ─── LLM Provider API Keys ──────────────────────────────────
# Add keys for the providers you want to use.
# The app works without them — you can still manage prompts.
# Offline echo models, rendering, linting, and bundled evals need no key.

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIza...

# ─── Local LLM (Ollama) ─────────────────────────────────────
# If you have Ollama running locally, set the base URL.
# Default: http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

# ─── Legacy 0.x compatibility (normally leave disabled) ────
# The current workbench is file-backed. These settings apply only when
# ASSAY_ENABLE_LEGACY_API=1 is explicitly enabled for a migration.
ASSAY_ENABLE_LEGACY_API=0
DATABASE_URL=sqlite:///database.db

# Required by docker compose so browser-to-backend mutations are authenticated.
# Replace this development value before exposing Assay beyond localhost.
ASSAY_API_TOKEN=local-development-token-change-me
ASSAY_ALLOW_REMOTE_MUTATIONS=true

# ─── Vector DB (ChromaDB) ────────────────────────────────────
CHROMA_DATA_PATH=./chroma_data

# ─── File-backed workspace ─────────────────────────────────
# Directory containing assay.yaml and prompts/. Defaults to the current directory.
# ASSAY_WORKSPACE=/path/to/workspace

# ─── CORS ───────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3001
